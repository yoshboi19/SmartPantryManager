<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Suggested Recipes"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#111827" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Strict Rule: Only shows recipes where you have 100% of required ingredients &amp; quantities."
        android:textSize="13sp"
        android:textColor="#4B5563"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnStrictMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Strict Matches"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnAlmostThereMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Almost There (-1)" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvZeroMatchFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No recipes match your pantry yet - add more ingredients to unlock recipes!"
        android:textSize="16sp"
        android:textColor="#DC2626"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSuggestedRecipes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>